# Copie ce fichier en .env.local puis remplis les valeurs. Ne commite jamais .env.local.

# --- Supabase (Project Settings → API Keys, et bouton "Connect" pour l'URL) ---
# Publiques : envoyées au navigateur, protégées par le RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TON-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REMPLACE_MOI
# SECRÈTE : contourne le RLS. Serveur uniquement, jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REMPLACE_MOI

# --- Chiffrement des liens .ics (32 octets en base64) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Si tu la changes, les liens déjà enregistrés deviennent illisibles (il faudra les recoller).
ICS_ENCRYPTION_KEY=REMPLACE_MOI

# --- Domaines autorisés pour les liens .ics (séparés par des virgules) ---
ICS_ALLOWED_HOSTS=mon-espace.helmo.be

# --- Notifications (phase 3) : générées par `npm run setup:push` ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Secret partagé entre pg_cron et l'Edge Function send-reminders
CRON_SECRET=
